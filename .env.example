# ===== 必填 =====
# BotFather 创建机器人后得到的 token
BOT_TOKEN=

# TypeSafe / Jev API key（https://typesafe.ai）
TYPESAFE_API_KEY=

# ===== 可选（用于"自然语言 → Jev 模板"编译器）=====
# 任何 OpenAI 兼容端点均可（OpenAI / DeepSeek / 自建网关…）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== 可选（一般无需改动）=====
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
DB_PATH=data/tgfilter.db
DEFAULT_INTERVAL_MINUTES=20
JEV_CONCURRENCY=8
