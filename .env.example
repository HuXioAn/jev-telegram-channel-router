# ===== 必填 =====
# BotFather 创建机器人后得到的 token
BOT_TOKEN=

# TypeSafe / Jev API key（https://typesafe.ai，判定模型，负责逐条过滤）
TYPESAFE_API_KEY=

# ===== 可选：LLM（仅用于「自然语言 → Jev 模板」编译器）=====
# 任意 OpenAI 兼容端点均可；BASE_URL 需含版本前缀（会直接拼 /chat/completions）。
# 留空则停用自然语言编译，只能在向导里直接粘贴 JSON 模板。
#
#   OpenAI        https://api.openai.com/v1                gpt-4o-mini / gpt-4.1-mini
#   DeepSeek      https://api.deepseek.com/v1              deepseek-chat
#   Kimi (月之暗面) https://api.moonshot.cn/v1               moonshot-v1-8k / kimi-k2-...
#   Qwen (阿里)    https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   智谱 GLM      https://open.bigmodel.cn/api/paas/v4     glm-4-plus
#   OpenRouter    https://openrouter.ai/api/v1             openai/gpt-4o-mini 等任意模型
#   Ollama 本地    http://localhost:11434/v1                qwen2.5:14b 等
#   vLLM/LM Studio http://localhost:8000/v1                （自部署模型名）
#   Anthropic 兼容 https://api.anthropic.com/v1            claude-sonnet-4-...
#   Gemini 兼容    https://generativelanguage.googleapis.com/v1beta/openai/   gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== 可选（一般无需改动）=====
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
DB_PATH=data/tgfilter.db
# 频道刷新间隔默认值（分钟）；物化时取该频道订阅间隔的最小值，管理员可 /admin watch 调整
DEFAULT_INTERVAL_MINUTES=20
JEV_CONCURRENCY=8
# 单次联合判定的问题上限（该频道所有订阅模板的问题并集超过时按模板分片）
JUDGE_MAX_QUESTIONS=24

# ===== 管理员（bot owner）=====
# 逗号分隔的 Telegram 用户 id；只有这些人能在私聊里使用 /admin（用量查询、用户管理、配额）。
# 留空则管理员功能整体禁用。查询自己的 id：给任意 getid 机器人发一条消息。
ADMIN_USER_IDS=

# 新用户默认状态：active（默认，直接可用）/ blocked（邀请制，需管理员 /admin unblock 放行）
DEFAULT_USER_STATUS=active
