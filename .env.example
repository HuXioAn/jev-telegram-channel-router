# ===== Required =====
# Bot token from BotFather (@BotFather → /newbot)
BOT_TOKEN=

# TypeSafe / Jev API key (https://typesafe.ai) — the judgment model that
# classifies every new post. This is the core of the message router.
TYPESAFE_API_KEY=

# ===== Optional: LLM (only used by the "natural language → Jev template" compiler) =====
# Any OpenAI-compatible endpoint works; BASE_URL must include the version
# prefix (the client appends /chat/completions to it).
# Leave empty to disable natural-language compilation (you can then only paste
# a raw JSON template in the wizard).
#
#   OpenAI        https://api.openai.com/v1                gpt-4o-mini / gpt-4.1-mini
#   DeepSeek      https://api.deepseek.com/v1              deepseek-chat
#   Kimi          https://api.moonshot.cn/v1               moonshot-v1-8k / kimi-k2-...
#   Qwen          https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   GLM (Zhipu)   https://open.bigmodel.cn/api/paas/v4     glm-4-plus
#   OpenRouter    https://openrouter.ai/api/v1             openai/gpt-4o-mini etc.
#   Ollama (local) http://localhost:11434/v1               qwen2.5:14b etc.
#   vLLM/LM Studio http://localhost:8000/v1                (your served model name)
#   Anthropic     https://api.anthropic.com/v1             claude-sonnet-4-...
#   Gemini        https://generativelanguage.googleapis.com/v1beta/openai/   gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== Optional (defaults are fine for most deployments) =====
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
DB_PATH=data/tgfilter.db
# Default channel refresh interval (minutes); materialization takes the minimum
# across the channel's subscriptions. Admins can tune per channel via /admin watch.
DEFAULT_INTERVAL_MINUTES=20
JEV_CONCURRENCY=8
# Max questions per union judgment call (a channel's template-question union
# beyond this is split into per-template shards).
JUDGE_MAX_QUESTIONS=24
# Default UI language for users who never picked one: en | zh.
# Users switch with /lang; admins change the instance default with /admin lang.
DEFAULT_LANG=en

# ===== Admin (bot owner) =====
# Comma-separated Telegram user ids; only these can use /admin in private chat
# (usage stats, user management, quotas). Leave empty to disable admin commands.
# Find your id by messaging any "get id" bot.
ADMIN_USER_IDS=

# Default status for new users: active (open) / blocked (invite-only; requires
# an admin /admin unblock before the user can do anything)
DEFAULT_USER_STATUS=active
