[Unit]
Description=tg-filter-bot (public channel -> Jev filter -> DM/channel routing)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/work/tg-filter-bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/work/tg-filter-bot/.venv/bin/python -m tgfilter
Restart=always
RestartSec=5
StandardOutput=append:/root/work/tg-filter-bot/data/bot.log
StandardError=append:/root/work/tg-filter-bot/data/bot.log

[Install]
WantedBy=multi-user.target
